{
    "name": "travel-agency-backend",
    "version": "1.0.0",
    "description": "",
    "main": "server.js",
    "scripts": {
        "build": "babel . --out-dir dist --copy-files --ignore node_modules",
        "start": "node dist/server.js",
        "dev": "nodemon --exec babel-node server.js",
        "seed:admin": "babel-node seeders/admin.seeder.js",
        "seed:users": "babel-node seeders/user.seeder.js",
        "seed:locations": "babel-node seeders/location.seeder.js",
        "seed:hotels": "babel-node seeders/hotel.seeder.js",
        "seed:packages": "babel-node seeders/package.seeder.js",
        "seed:bookings": "babel-node seeders/booking.seeder.js",
        "seed:all": "npm run seed:admin && npm run seed:users && npm run seed:locations && npm run seed:hotels && npm run seed:packages && npm run seed:bookings"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cloudinary": "^2.10.0",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.3.1",
        "express-validator": "^7.3.1",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.3.0",
        "multer": "^2.1.1",
        "nodemailer": "^9.0.1",
        "razorpay": "^2.9.6"
    },
    "devDependencies": {
        "@babel/cli": "^7.28.6",
        "@babel/core": "^7.29.0",
        "@babel/node": "^7.29.0",
        "@babel/preset-env": "^7.29.0",
        "nodemon": "^3.1.14"
    },
    "babel": {
        "presets": [
            "@babel/preset-env"
        ]
    },
    "allowScripts": {
        "bcrypt@6.0.0": true,
        "core-js@3.49.0": true
    }
}
